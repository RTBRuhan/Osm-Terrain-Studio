{
  "name": "osm-terrain-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web tool to rotate OSM maps, draw/scale/rotate a georeferenced selection box, and export OSM/GeoJSON/Unity (EasyRoad3D) road data for game terrains.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/selfcheck.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
